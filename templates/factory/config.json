  "demo": {
    "enabled": false,
    "max_parallel": 1,
    "max_file_mb": 50,
    "evidence_branch": "factory-evidence",
    "port_before": 5181,
    "port_after": 5182,
    "vars": {
      "install": "the project's install command, for example `npm ci`",
